---
import Base from '../layouts/Base.astro';
import { GAME_URL } from '../site.js';
---
<Base title="My Booth Tank" description="A shrimp tank made at the Shrimprium booth." noindex footer={false}>
  <main class="booth-page">
    <!-- 부스 링크는 shrimprium.com/booth/#<토큰>. 토큰은 해시에만 있어 이 서버로 보내지지 않는다. -->
    <div class="booth-tank" data-booth-tank data-game={GAME_URL}>
      <!-- 로딩은 게임 뷰어가 별자리로 보여 준다. 여기 글자는 잘못된 링크일 때만 쓴다. -->
      <p class="booth-status" data-booth-status></p>
    </div>
  </main>
</Base>

<style>
  /* 모바일용: 고정 헤더 아래 남은 화면에 게임 수조(320×640, 1:2)를 딱 맞춘다. 스크롤 없음. */
  /* 공통 body 의 min-height:100vh 는 주소창이 보일 때 실제 화면(100dvh)보다 길어 빈 스크롤이 생긴다. */
  :global(body) { min-height: 100dvh; }
  .booth-page {
    --header: 72px;
    height: 100dvh;
    box-sizing: border-box;
    padding: var(--header) 8px 8px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  /* 600px 보다 넓으면 헤더 버튼이 커져 헤더가 84px 이다(global.css). */
  @media (min-width: 601px) { .booth-page { --header: 84px; } }
  .booth-tank {
    position: relative;
    width: min(100%, calc((100dvh - var(--header) - 8px) / 2));
    aspect-ratio: 1 / 2;
    border-radius: 12px;
    overflow: hidden;
    /* 게임 뷰어의 별자리 로딩 배경과 같은 색이라 넘어갈 때 깜빡이지 않는다. */
    background: radial-gradient(ellipse at 50% 35%, #12293a 0%, #0a1624 48%, #050a12 100%);
    box-shadow: 0 0 0 1px var(--line), 0 12px 40px #0008;
  }
  .booth-tank :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .booth-status { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; margin: 0; color: var(--muted); }
</style>

<script>
  // 게임의 단일 수조 뷰어(/mytank/<token>?single=1)를 그대로 띄운다.
  const box = document.querySelector<HTMLElement>('[data-booth-tank]');
  const status = box?.querySelector<HTMLElement>('[data-booth-status]');
  const token = location.hash.slice(1);
  if (box && status) {
    if (!/^[a-f0-9]{64}$/.test(token)) {
      status.textContent = 'This booth link is invalid. Please check the address.';
    } else {
      const frame = document.createElement('iframe');
      frame.src = `${box.dataset.game}/mytank/${token}?single=1`;
      frame.title = 'Booth tank';
      frame.referrerPolicy = 'no-referrer';
      frame.allow = 'fullscreen';
      frame.addEventListener('load', () => status.remove(), { once: true });
      box.append(frame);
    }
  }
</script>
