---
import Base from '../layouts/Base.astro';
import StoreLinks from '../components/StoreLinks.astro';
import { GAME_URL } from '../site.js';
---
<Base title="My Booth Tank" description="A shrimp tank made at the Shrimprium booth." noindex>
  <main class="page booth-page">
    <p class="eyebrow">Shrimprium Booth</p>
    <h1 class="page-title">My booth tank</h1>
    <!-- 부스 링크는 shrimprium.com/booth/#<토큰>. 토큰은 해시에만 있어 이 서버로 보내지지 않는다. -->
    <div class="booth-tank" data-booth-tank data-game={GAME_URL}>
      <!-- 로딩은 게임 뷰어가 별자리로 보여 준다. 여기 글자는 잘못된 링크일 때만 쓴다. -->
      <p class="booth-status" data-booth-status></p>
    </div>
    <!-- 휴대폰 공유 창(카카오톡·메일·메시지 등). 지원하지 않는 브라우저에서는 링크를 복사한다. -->
    <button class="store booth-share" type="button" data-booth-share hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18 16.1c-.8 0-1.5.3-2 .8l-7.1-4.1c.1-.3.1-.5.1-.8s0-.5-.1-.8L16 7.1c.5.5 1.2.8 2 .8 1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3c0 .3 0 .5.1.8L8 9.8C7.5 9.3 6.8 9 6 9c-1.7 0-3 1.3-3 3s1.3 3 3 3c.8 0 1.5-.3 2-.8l7.1 4.2c-.1.2-.1.4-.1.7 0 1.6 1.3 2.9 2.9 2.9s2.9-1.3 2.9-2.9-1.2-3-2.8-3z"/></svg>
      <span><small>KakaoTalk, Mail, Messages</small><b data-booth-share-label>Share my tank</b></span>
    </button>
    <StoreLinks />
  </main>
</Base>

<style>
  /* 모바일용: 본게임처럼 수조가 화면 너비를 채운다. */
  .booth-page { text-align: center; padding-top: 96px; }
  .booth-page .page-title { font-size: clamp(28px, 7vw, 40px); }
  /* 게임 수조와 같은 320×640(1:2). */
  .booth-tank {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1 / 2;
    margin: 20px auto 0;
    border-radius: 12px;
    overflow: hidden;
    /* 게임 뷰어의 별자리 로딩 배경과 같은 색이라 넘어갈 때 깜빡이지 않는다. */
    background: radial-gradient(ellipse at 50% 35%, #12293a 0%, #0a1624 48%, #050a12 100%);
    box-shadow: 0 0 0 1px var(--line), 0 12px 40px #0008;
  }
  .booth-tank :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .booth-share { margin-top: 20px; font: inherit; cursor: pointer; }
  .booth-share b { font-weight: 600; }
  /* .store 의 display 가 hidden 속성을 덮어쓰므로 직접 숨긴다. */
  .booth-share[hidden] { display: none; }
  .booth-status { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; margin: 0; color: var(--muted); }
</style>

<script>
  // 게임의 단일 수조 뷰어(/mytank/<token>?single=1)를 그대로 띄운다.
  const box = document.querySelector<HTMLElement>('[data-booth-tank]');
  const status = box?.querySelector<HTMLElement>('[data-booth-status]');
  const token = location.hash.slice(1);
  if (box && status) {
    if (!/^[a-f0-9]{64}$/.test(token)) {
      status.textContent = 'This booth link is invalid. Please check the address.';
    } else {
      const frame = document.createElement('iframe');
      frame.src = `${box.dataset.game}/mytank/${token}?single=1`;
      frame.title = 'Booth tank';
      frame.referrerPolicy = 'no-referrer';
      frame.allow = 'fullscreen';
      frame.addEventListener('load', () => status.remove(), { once: true });
      box.append(frame);
      const share = document.querySelector<HTMLButtonElement>('[data-booth-share]');
      const label = share?.querySelector<HTMLElement>('[data-booth-share-label]');
      if (share && label) {
        share.hidden = false;
        share.addEventListener('click', async () => {
          const url = location.href;
          if (navigator.share) {
            // 사용자가 공유 창을 닫아도 오류로 보지 않는다.
            try { await navigator.share({ title: 'My Shrimprium booth tank', url }); } catch { /* cancelled */ }
            return;
          }
          try { await navigator.clipboard.writeText(url); label.textContent = 'Link copied'; }
          catch { prompt('Copy this link', url); }
        });
      }
    }
  }
</script>
