---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../site.js';

const posts = (await getCollection('devlog')).sort((a, b) => b.data.date - a.data.date);
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Devlog" description="Updates and behind-the-scenes notes from the making of Shrimprium.">
  <main class="page">
    <p class="eyebrow">Devlog</p>
    <h1 class="page-title">Notes from <em>the tank</em></h1>
    <ol class="posts">
      {posts.map((post) => (
        <li>
          <a href={url(`/devlog/${post.id}/`)}>
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <strong>{post.data.title}</strong>
            {post.data.summary && <span>{post.data.summary}</span>}
          </a>
        </li>
      ))}
    </ol>
  </main>
</Base>
