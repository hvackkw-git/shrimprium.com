---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../site.js';

const posts = (await getCollection('devlog')).sort((a, b) => b.data.date - a.data.date);
const fmt = (d) => d.toISOString().slice(0, 10).replaceAll('-', '. ');
---
<Base title="Devlog" description="Shrimprium 개발 이야기와 업데이트 소식">
  <main class="page">
    <p class="eyebrow">Devlog</p>
    <h1 class="page-title">만들어가는 <em>이야기</em></h1>
    <ol class="posts">
      {posts.map((post) => (
        <li>
          <a href={url(`/devlog/${post.id}/`)}>
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <strong>{post.data.title}</strong>
            {post.data.summary && <span>{post.data.summary}</span>}
          </a>
        </li>
      ))}
    </ol>
  </main>
</Base>
