---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../config/site.js';
import { BREEDS, CATEGORIES, GENE_COLORS, PATTERNS, OPACITY_TIERS, STAR_GRADES, gradeOf, spriteUrl, overlayUrl } from '../../data/wiki.js';

const spriteStyle = (b) => {
  const layers = [];
  if (b.overlay) layers.push(`url('${withBase(overlayUrl(b.overlay))}')`);
  layers.push(`url('${withBase(spriteUrl(b.sprite))}')`);
  return `background-image:${layers.join(',')}`;
};
const starText = (n) => '★'.repeat(Math.floor(n)) + (n % 1 ? '½' : '');
---
<Base title="새우 위키" description="Shrimprium 새우 품종 도감 — 유전자, 교배 레시피, 등급까지 게임 실데이터 기반 전문 위키">
  <header class="wiki-hero">
    <h1>새우 위키</h1>
    <p class="sub">게임 유전 시스템 실데이터 기반 · 품종 {BREEDS.length}종 수록</p>
  </header>

  <nav class="chip-row" id="wikiChips" aria-label="품종 분류 필터">
    <button class="chip is-on" data-cat="all">전체</button>
    {CATEGORIES.map((c) => <button class="chip" data-cat={c.key}>{c.label}</button>)}
  </nav>

  <ul class="wiki-grid" id="wikiGrid">
    {BREEDS.map((b) => {
      const g = gradeOf(b.stars);
      return (
        <li data-cat={b.cat}>
          <button
            class="wiki-card"
            data-name={b.name}
            data-stars={starText(b.stars) + ' ' + b.stars.toFixed(1)}
            data-grade={g.label}
            data-gradecolor={g.color}
            data-recipe={b.recipe}
            data-desc={b.desc}
            data-spr={spriteStyle(b)}
          >
            <span class="tankette" style={`--ac:${b.hex}`}>
              <i class="shrimp-sprite" style={spriteStyle(b)}></i>
            </span>
            <span class="w-name">{b.name}</span>
            <span class="w-meta">
              <b class="w-stars">{starText(b.stars)}</b>
              <em class="w-grade" style={`--gc:${g.color}`}>{g.label}</em>
            </span>
          </button>
        </li>
      );
    })}
  </ul>

  <section class="knowhow">
    <h2>유전자 시스템</h2>
    <div class="px-card theme-cyan">
      <div class="px-head"><span class="px-ico">🧬</span><p class="px-title">색상 유전자 6축</p></div>
      <div class="px-body">
        <p>모든 새우는 6가지 색 유전자를 <b>합이 1인 가중치</b>로 나눠 갖습니다. 가장 높은 색이 겉모습을 결정하고, 두 색이 각각 40% 이상이면 조합색이 발현됩니다.</p>
        <div class="gene-chips">
          {GENE_COLORS.map((c) => <span class="gene-chip"><i style={`background:${c.hex}`}></i>{c.label}</span>)}
        </div>
        <p class="fine">※ 화이트는 자연 개체풀에 존재하지 않으며 돌연변이로만 나타납니다.</p>
      </div>
    </div>

    <h2>교배 공식</h2>
    <div class="px-card theme-gold">
      <div class="px-head"><span class="px-ico">💕</span><p class="px-title">자식 유전자 계산법</p></div>
      <div class="px-body formula">
        <p><b class="k">색상</b> 각 색 가중치 = (부모A + 부모B) ÷ 2. 강화 색상을 고르면 나머지 색이 각각 −10%p 되고 그만큼 강화색에 더해집니다.</p>
        <p><b class="k">돌연변이</b> 2% 확률로 최고 형질이 +0 ~ 0.1 추가 상승. 희귀종의 지름길입니다.</p>
        <p><b class="k">불투명도</b> max(부모A, 부모B) + min(부모A, 부모B) × 0.1 — 세대를 거듭할수록 진해집니다.</p>
        <p><b class="k">패턴</b> 두 부모의 패턴 중 하나를 직접 선택해 물려줍니다.</p>
      </div>
    </div>

    <h2>패턴 4종</h2>
    <ul class="pattern-list">
      {PATTERNS.map((p) => (
        <li class="pattern-item">
          <span class="p-name">{p.label}<b>{p.stars ? `+${p.stars}★` : '—'}</b></span>
          <span class="p-desc">{p.desc}</span>
        </li>
      ))}
    </ul>

    <h2>불투명도 티어</h2>
    <ul class="pattern-list">
      {OPACITY_TIERS.map((t) => (
        <li class="pattern-item">
          <span class="p-name">{t.label}<b>{t.range}</b></span>
          <span class="p-desc">{t.desc}</span>
        </li>
      ))}
    </ul>

    <h2>별점과 등급</h2>
    <div class="grade-table">
      {STAR_GRADES.map((g) => (
        <span class="grade-pill" style={`--gc:${g.color}`}>{g.label}<b>★{g.minStars}+</b></span>
      ))}
    </div>
    <p class="fine" style="margin-top:10px;">별점 = 기본 1 + 색상 점수(야생 0 / 원색 0.5 / 조합색·화이트 1) + 패턴 점수(스페클·백라인 0.5 / 릴리 1). 돌연변이 특수종은 고정 별점.</p>

    <p style="margin-top:26px;">더 자세한 사육법은 <a href={withBase('/guide/')}>새우백과 가이드</a>에서 이어집니다.</p>
  </section>

  <!-- 바텀시트: 품종 상세 -->
  <div class="sheet-dim" id="sheetDim" hidden></div>
  <aside class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="품종 상세" hidden>
    <div class="sheet-grip" aria-hidden="true"></div>
    <div class="sheet-tank"><i class="shrimp-sprite big" id="sheetSprite"></i></div>
    <div class="sheet-head">
      <h3 id="sheetName"></h3>
      <span class="w-grade" id="sheetGrade"></span>
    </div>
    <p class="sheet-stars" id="sheetStars"></p>
    <dl class="sheet-info">
      <dt>교배 레시피</dt><dd id="sheetRecipe"></dd>
      <dt>도감 노트</dt><dd id="sheetDesc"></dd>
    </dl>
    <button class="px-btn sheet-close" id="sheetClose">닫기</button>
  </aside>

  <script>
    // 카테고리 필터
    const chips = document.getElementById('wikiChips');
    const grid = document.getElementById('wikiGrid');
    chips.addEventListener('click', (e) => {
      const btn = e.target.closest('.chip');
      if (!btn) return;
      chips.querySelectorAll('.chip').forEach((c) => c.classList.toggle('is-on', c === btn));
      const cat = btn.dataset.cat;
      grid.querySelectorAll('li').forEach((li) => {
        li.style.display = (cat === 'all' || li.dataset.cat === cat) ? '' : 'none';
      });
    });

    // 바텀시트 상세 — main의 stacking context(z-index:1)에 갇혀 하단 탭바 밑에
    // 깔리지 않도록 body 직속으로 옮긴다.
    const sheet = document.getElementById('sheet');
    const dim = document.getElementById('sheetDim');
    document.body.append(dim, sheet);
    const open = (card) => {
      document.getElementById('sheetSprite').style.cssText = card.dataset.spr;
      document.getElementById('sheetName').textContent = card.dataset.name;
      const g = document.getElementById('sheetGrade');
      g.textContent = card.dataset.grade;
      g.style.setProperty('--gc', card.dataset.gradecolor);
      document.getElementById('sheetStars').textContent = card.dataset.stars;
      document.getElementById('sheetRecipe').textContent = card.dataset.recipe;
      document.getElementById('sheetDesc').textContent = card.dataset.desc;
      sheet.hidden = false; dim.hidden = false;
      requestAnimationFrame(() => { sheet.classList.add('up'); dim.classList.add('up'); });
    };
    const close = () => {
      sheet.classList.remove('up'); dim.classList.remove('up');
      setTimeout(() => { sheet.hidden = true; dim.hidden = true; }, 220);
    };
    grid.addEventListener('click', (e) => {
      const card = e.target.closest('.wiki-card');
      if (card) open(card);
    });
    dim.addEventListener('click', close);
    document.getElementById('sheetClose').addEventListener('click', close);
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !sheet.hidden) close(); });
  </script>
</Base>

<style>
  .wiki-hero { margin-bottom: 14px; }
  .wiki-hero h1 { margin-bottom: 4px; }
  .wiki-hero .sub { color: var(--muted); font-size: 13px; }

  /* 필터 칩 — 상단 고정 */
  .chip-row {
    position: sticky; top: 56px; z-index: 40;
    display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none;
    padding: 10px 2px; margin: 0 -2px 14px;
    background: linear-gradient(180deg, var(--bg) 78%, transparent);
    -webkit-overflow-scrolling: touch;
  }
  .chip-row::-webkit-scrollbar { display: none; }
  .chip {
    font-family: var(--pixel11); font-size: 12px; font-weight: 700;
    padding: 8px 14px; flex: 0 0 auto; cursor: pointer;
    border: var(--px-b); background: #1a222e; color: var(--text);
    box-shadow: var(--px-bevel); border-radius: 0;
  }
  .chip.is-on { background: var(--ok); color: #0d141c; border-color: #000; }

  /* 도감 그리드 */
  .wiki-grid {
    list-style: none; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px;
  }
  .wiki-grid li { margin: 0; }
  .wiki-card {
    width: 100%; height: 100%; cursor: pointer; text-align: left;
    display: flex; flex-direction: column; gap: 8px;
    font-family: var(--pixel11); color: var(--text);
    background: var(--panel); border: var(--px-b); border-radius: 0;
    padding: 10px; box-shadow: var(--px-bevel), var(--px-pop);
    transition: border-color 0.12s, background 0.12s, transform 0.06s;
  }
  .wiki-card:hover { border-color: rgba(121, 215, 255, 0.5); background: #182230; }
  .wiki-card:active { transform: translate(2px, 2px); box-shadow: var(--px-bevel); }

  /* 카드 속 미니 수조 */
  .tankette {
    display: flex; align-items: center; justify-content: center;
    height: 84px; overflow: hidden;
    border: 2px solid #000;
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--ac) 45%, transparent);
    background: linear-gradient(180deg, #0e3346 0%, #0a2433 60%, #071824 100%);
  }
  .w-name { font-size: 13px; font-weight: 700; line-height: 1.35; }
  .w-meta { display: flex; align-items: center; gap: 6px; }
  .w-stars { color: var(--gold); font-size: 11px; font-family: var(--pixel9); }
  .w-grade {
    font-family: var(--pixel9); font-size: 10px; font-style: normal;
    color: var(--gc, var(--muted));
    background: var(--panel-deep); border: 2px solid #000; box-shadow: var(--px-bevel);
    padding: 2px 7px;
  }

  /* 스프라이트 시트 256×32 · 프레임 32×32 (오버레이 패턴 겸용) */
  .shrimp-sprite {
    --z: 2;
    display: block;
    width: calc(32px * var(--z)); height: calc(32px * var(--z));
    background-repeat: no-repeat;
    background-size: calc(256px * var(--z)) calc(32px * var(--z));
    image-rendering: pixelated;
    animation: shrimp4 1.1s steps(8) infinite;
  }
  .shrimp-sprite.big { --z: 3.5; }
  @keyframes shrimp4 { from { background-position-x: 0; } to { background-position-x: calc(-256px * var(--z)); } }
  @media (prefers-reduced-motion: reduce) { .shrimp-sprite { animation: none; } }

  /* 전문지식 */
  .knowhow { margin-top: 36px; }
  .knowhow .px-card { margin-bottom: 8px; }
  .gene-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 10px; }
  .gene-chip {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 12px; font-weight: 700; padding: 6px 10px;
    background: var(--panel-deep); border: 2px solid #000; box-shadow: var(--px-bevel);
  }
  .gene-chip i { width: 12px; height: 12px; border: 2px solid #000; display: inline-block; }
  .fine { font-family: var(--pixel9); font-size: 11px; color: var(--muted); }
  .formula p { font-size: 13px; }
  .formula .k {
    display: inline-block; min-width: 72px; margin-right: 6px;
    color: var(--warn); font-family: var(--pixel9); font-size: 11px;
  }
  .pattern-list { list-style: none; padding: 0; display: grid; gap: 8px; }
  .pattern-item {
    margin: 0; padding: 10px 14px;
    background: var(--panel); border: var(--px-b); box-shadow: var(--px-bevel);
    display: flex; flex-direction: column; gap: 3px;
  }
  .p-name { font-weight: 700; font-size: 13px; display: flex; align-items: center; gap: 8px; }
  .p-name b { color: var(--info); font-family: var(--pixel9); font-size: 10px; font-weight: 400; }
  .p-desc { color: var(--muted); font-size: 12px; }
  .grade-table { display: flex; flex-wrap: wrap; gap: 8px; }
  .grade-pill {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 12px; font-weight: 700; padding: 6px 10px; color: var(--gc);
    background: var(--panel-deep); border: 2px solid #000; box-shadow: var(--px-bevel);
  }
  .grade-pill b { font-family: var(--pixel9); font-size: 10px; color: var(--muted); font-weight: 400; }

  /* 바텀시트 */
  .sheet-dim {
    position: fixed; inset: 0; z-index: 180;
    background: rgba(4, 8, 12, 0.7); opacity: 0; transition: opacity 0.2s;
  }
  .sheet-dim.up { opacity: 1; }
  .sheet {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 190;
    max-width: 560px; margin: 0 auto;
    background: var(--panel-body); border: 3px solid #000; border-bottom: none;
    box-shadow: inset 0 0 0 2px var(--info), 0 -6px 0 rgba(0, 0, 0, 0.4);
    padding: 12px 18px calc(20px + env(safe-area-inset-bottom));
    transform: translateY(102%); transition: transform 0.22s ease-out;
  }
  .sheet.up { transform: translateY(0); }
  .sheet-grip { width: 44px; height: 5px; margin: 0 auto 12px; background: rgba(255, 255, 255, 0.25); }
  .sheet-tank {
    display: flex; align-items: center; justify-content: center;
    height: 128px; margin-bottom: 14px; overflow: hidden;
    border: 2px solid #000;
    box-shadow: inset 0 0 0 2px rgba(121, 215, 255, 0.3);
    background: linear-gradient(180deg, #0e3346 0%, #0a2433 60%, #071824 100%);
  }
  .sheet-head { display: flex; align-items: center; gap: 10px; }
  .sheet-head h3 { margin: 0; font-size: 17px; }
  .sheet-stars { color: var(--gold); font-family: var(--pixel9); font-size: 12px; margin: 4px 0 10px; }
  .sheet-info { margin: 0 0 16px; }
  .sheet-info dt { font-family: var(--pixel9); font-size: 11px; color: var(--info); margin-top: 10px; }
  .sheet-info dd { margin: 2px 0 0; font-size: 13px; color: var(--text); }
  .sheet-close { width: 100%; }
</style>
