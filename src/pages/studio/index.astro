---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../config/site.js';
---
<Base title="디자인 스튜디오" description="나만의 새우·배경·플랫폼 블록을 도트로 그리는 Shrimprium 디자인 스튜디오">
  <h1>디자인 스튜디오</h1>
  <p class="st-sub">나만의 새우, 배경 타일, 플랫폼 블록을 도트로 그려보세요. 그림은 이 브라우저에 자동 저장되고 PNG로 내보낼 수 있어요.</p>

  <nav class="chip-row-st" id="stModes" aria-label="디자인 모드">
    <button class="chip is-on" data-mode="shrimp">🦐 새우</button>
    <button class="chip" data-mode="bg">🌊 배경 타일</button>
    <button class="chip" data-mode="block">🧱 플랫폼 블록</button>
  </nav>

  <div class="st-canvas-wrap" id="stWrap">
    <canvas id="stCanvas" data-template={withBase('/assets/shrimp/shrimp-4frame-cherry_red.png')}></canvas>
  </div>

  <div class="st-tools" id="stTools">
    <button class="px-btn tool is-on" data-tool="pen">✏️ 펜</button>
    <button class="px-btn tool" data-tool="eraser">🧽 지우개</button>
    <button class="px-btn tool" data-tool="fill">🪣 채우기</button>
    <button class="px-btn" id="stUndo">↩ 되돌리기</button>
    <button class="px-btn" id="stClear">🗑 초기화</button>
  </div>

  <div class="st-palette" id="stPalette"></div>
  <label class="st-custom">
    커스텀 색상 <input type="color" id="stCustom" value="#6ef3a5" />
  </label>

  <div class="st-actions">
    <button class="px-btn primary" id="stExport">⬇ PNG로 저장</button>
  </div>
  <p class="st-tip">💡 완성한 디자인은 곧 열릴 <a href={withBase('/gallery/')}>수조 갤러리</a>에서 자랑할 수 있게 될 예정이에요.</p>

  <script>
    const MODES = {
      shrimp: { w: 32, h: 32, name: 'my-shrimp', template: true },
      bg:     { w: 16, h: 16, name: 'my-background', template: false },
      block:  { w: 16, h: 16, name: 'my-block', template: false },
    };
    // 게임 유전자 색 + 보조 톤
    const PALETTE = [
      '#ff4757', '#5C0F0F', '#E8850A', '#F3C83F', '#3F9A3F', '#7dff5e',
      '#3F6FF3', '#0F1F5C', '#79d7ff', '#7A3FB3', '#ffb3c8', '#F0F0F8',
      '#8B7355', '#3A3A3A', '#0b0f14', '#ffffff',
    ];

    const cv = document.getElementById('stCanvas');
    const ctx = cv.getContext('2d', { willReadFrequently: true });
    const wrap = document.getElementById('stWrap');
    const paletteEl = document.getElementById('stPalette');
    const modesEl = document.getElementById('stModes');
    const toolsEl = document.getElementById('stTools');

    let mode = 'shrimp';
    let tool = 'pen';
    let color = PALETTE[0];
    let undoStack = [];
    const storeKey = () => 'shrimprium-studio-' + mode;

    // 팔레트 렌더
    PALETTE.forEach((hex, i) => {
      const b = document.createElement('button');
      b.className = 'swatch' + (i === 0 ? ' is-on' : '');
      b.style.background = hex;
      b.dataset.hex = hex;
      b.setAttribute('aria-label', '색상 ' + hex);
      paletteEl.appendChild(b);
    });
    paletteEl.addEventListener('click', (e) => {
      const s = e.target.closest('.swatch');
      if (!s) return;
      color = s.dataset.hex;
      paletteEl.querySelectorAll('.swatch').forEach((x) => x.classList.toggle('is-on', x === s));
      setTool('pen');
    });
    document.getElementById('stCustom').addEventListener('input', (e) => {
      color = e.target.value;
      paletteEl.querySelectorAll('.swatch').forEach((x) => x.classList.remove('is-on'));
      setTool('pen');
    });

    function setTool(t) {
      tool = t;
      toolsEl.querySelectorAll('.tool').forEach((b) => b.classList.toggle('is-on', b.dataset.tool === t));
    }
    toolsEl.addEventListener('click', (e) => {
      const b = e.target.closest('.tool');
      if (b) setTool(b.dataset.tool);
    });

    function pushUndo() {
      undoStack.push(ctx.getImageData(0, 0, cv.width, cv.height));
      if (undoStack.length > 30) undoStack.shift();
    }
    document.getElementById('stUndo').addEventListener('click', () => {
      const im = undoStack.pop();
      if (im) { ctx.putImageData(im, 0, 0); save(); }
    });
    document.getElementById('stClear').addEventListener('click', () => {
      pushUndo();
      ctx.clearRect(0, 0, cv.width, cv.height);
      save();
    });

    function save() {
      try { localStorage.setItem(storeKey(), cv.toDataURL()); } catch {}
    }

    function loadTemplate() {
      const img = new Image();
      img.onload = () => {
        ctx.imageSmoothingEnabled = false;
        // 스프라이트 시트(256×32)의 첫 프레임(32×32)을 도트 그대로 가져옴
        ctx.drawImage(img, 0, 0, 32, 32, 0, 0, 32, 32);
        save();
      };
      img.src = cv.dataset.template;
    }

    function setMode(m) {
      mode = m;
      const cfg = MODES[m];
      cv.width = cfg.w; cv.height = cfg.h;
      wrap.style.setProperty('--ar', cfg.w + ' / ' + cfg.h);
      undoStack = [];
      const saved = localStorage.getItem(storeKey());
      if (saved) {
        const img = new Image();
        img.onload = () => { ctx.imageSmoothingEnabled = false; ctx.drawImage(img, 0, 0); };
        img.src = saved;
      } else if (cfg.template) {
        loadTemplate();
      }
    }
    modesEl.addEventListener('click', (e) => {
      const b = e.target.closest('.chip');
      if (!b) return;
      modesEl.querySelectorAll('.chip').forEach((x) => x.classList.toggle('is-on', x === b));
      setMode(b.dataset.mode);
    });

    // 그리기
    const hexToRgba = (hex) => {
      const n = parseInt(hex.slice(1), 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255, 255];
    };
    function cellAt(e) {
      const rect = cv.getBoundingClientRect();
      const x = Math.floor((e.clientX - rect.left) / rect.width * cv.width);
      const y = Math.floor((e.clientY - rect.top) / rect.height * cv.height);
      return (x >= 0 && x < cv.width && y >= 0 && y < cv.height) ? { x, y } : null;
    }
    function paint(x, y) {
      if (tool === 'eraser') { ctx.clearRect(x, y, 1, 1); return; }
      ctx.fillStyle = color;
      ctx.fillRect(x, y, 1, 1);
    }
    function floodFill(x, y) {
      const im = ctx.getImageData(0, 0, cv.width, cv.height);
      const d = im.data;
      const idx = (px, py) => (py * cv.width + px) * 4;
      const start = idx(x, y);
      const target = [d[start], d[start + 1], d[start + 2], d[start + 3]];
      const repl = hexToRgba(color);
      if (target.every((v, i) => v === repl[i])) return;
      const q = [[x, y]];
      while (q.length) {
        const [px, py] = q.pop();
        if (px < 0 || px >= cv.width || py < 0 || py >= cv.height) continue;
        const i = idx(px, py);
        if (d[i] !== target[0] || d[i + 1] !== target[1] || d[i + 2] !== target[2] || d[i + 3] !== target[3]) continue;
        d[i] = repl[0]; d[i + 1] = repl[1]; d[i + 2] = repl[2]; d[i + 3] = repl[3];
        q.push([px + 1, py], [px - 1, py], [px, py + 1], [px, py - 1]);
      }
      ctx.putImageData(im, 0, 0);
    }

    let drawing = false;
    cv.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      const c = cellAt(e);
      if (!c) return;
      pushUndo();
      if (tool === 'fill') { floodFill(c.x, c.y); save(); return; }
      drawing = true;
      cv.setPointerCapture(e.pointerId);
      paint(c.x, c.y);
    });
    cv.addEventListener('pointermove', (e) => {
      if (!drawing) return;
      const c = cellAt(e);
      if (c) paint(c.x, c.y);
    });
    const stop = () => { if (drawing) { drawing = false; save(); } };
    cv.addEventListener('pointerup', stop);
    cv.addEventListener('pointercancel', stop);

    // PNG 내보내기 (×10 확대)
    document.getElementById('stExport').addEventListener('click', () => {
      const out = document.createElement('canvas');
      out.width = cv.width * 10; out.height = cv.height * 10;
      const octx = out.getContext('2d');
      octx.imageSmoothingEnabled = false;
      octx.drawImage(cv, 0, 0, out.width, out.height);
      const a = document.createElement('a');
      a.download = 'shrimprium-' + MODES[mode].name + '.png';
      a.href = out.toDataURL('image/png');
      a.click();
    });

    setMode('shrimp');
  </script>
</Base>

<style>
  .st-sub { color: var(--muted); font-size: 13px; margin-bottom: 16px; }

  .chip-row-st { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; margin-bottom: 14px; }
  .chip-row-st::-webkit-scrollbar { display: none; }
  .chip {
    font-family: var(--pixel11); font-size: 12px; font-weight: 700;
    padding: 8px 14px; flex: 0 0 auto; cursor: pointer;
    border: var(--px-b); background: #1a222e; color: var(--text);
    box-shadow: var(--px-bevel); border-radius: 0;
  }
  .chip.is-on { background: var(--ok); color: #0d141c; border-color: #000; }

  .st-canvas-wrap {
    --ar: 32 / 32;
    max-width: 480px; margin: 0 auto;
    aspect-ratio: var(--ar);
    border: 3px solid #000;
    box-shadow: inset 0 0 0 2px rgba(200, 184, 255, 0.35), var(--px-pop);
    /* 투명 체커보드 */
    background:
      repeating-conic-gradient(#18202b 0% 25%, #10161e 0% 50%) 0 0 / 24px 24px;
  }
  .st-canvas-wrap canvas {
    display: block; width: 100%; height: 100%;
    image-rendering: pixelated;
    touch-action: none;
    cursor: crosshair;
  }

  .st-tools { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 12px; justify-content: center; }
  .st-tools .px-btn { font-size: 12px; padding: 8px 12px; }
  .st-tools .tool.is-on { background: var(--grape); color: #0d141c; border-color: #000; }

  .st-palette {
    display: grid; grid-template-columns: repeat(8, 1fr); gap: 6px;
    max-width: 480px; margin: 0 auto;
  }
  :global(.swatch) {
    aspect-ratio: 1; cursor: pointer; border-radius: 0;
    border: 2px solid #000;
    box-shadow: inset 2px 2px 0 rgba(255, 255, 255, 0.25), inset -2px -2px 0 rgba(0, 0, 0, 0.35);
  }
  :global(.swatch.is-on) { outline: 3px solid var(--gold); outline-offset: 1px; }

  .st-custom {
    display: flex; align-items: center; gap: 10px; justify-content: center;
    margin: 12px auto 0; font-size: 12px; color: var(--muted);
  }
  .st-custom input { width: 44px; height: 30px; border: 2px solid #000; background: var(--panel-deep); padding: 2px; }

  .st-actions { display: flex; justify-content: center; margin-top: 18px; }
  .st-tip { margin-top: 14px; font-size: 12px; color: var(--muted); text-align: center; }
</style>
