---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { url } from '../../site.js';

const items = (await getCollection('shrimpedia')).sort((a, b) => b.data.date - a.data.date);
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
// 카드에 보일 짧은 미리보기: 마크다운 기호를 걷어낸 본문 앞부분.
const excerpt = (body = '') => body.replace(/!\[[^\]]*\]\([^)]*\)/g, '').replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[#*_`>]/g, '').replace(/\s+/g, ' ').trim().slice(0, 220);
---
<Base title="Shrimpedia" description="Short, illustrated facts about shrimp, the real animals behind Shrimprium.">
  <main class="page lab-page">
    <p class="eyebrow">Shrimpedia</p>
    <h1 class="page-title">Shrimp <em>facts</em></h1>
    {items.length === 0 ? (
      <p class="lab-empty">Nothing here yet. Check back soon.</p>
    ) : (
      <ul class="lab-grid">
        {items.map((item) => (
          <li class="lab-card">
            <a href={url(`/shrimpedia/${item.id}/`)}>
              <Image src={item.data.image} alt={item.data.imageAlt ?? item.data.title} width={480} height={480} fit="cover" />
              <div class="body">
                <time datetime={item.data.date.toISOString()}>{fmt(item.data.date)}</time>
                <strong>{item.data.title}</strong>
                <p>{excerpt(item.body)}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Base>
