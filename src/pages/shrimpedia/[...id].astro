---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { url } from '../../site.js';

export async function getStaticPaths() {
  const items = await getCollection('shrimpedia');
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title={item.data.title} description={item.body?.replace(/\s+/g, ' ').trim().slice(0, 155)}>
  <main class="page">
    <a class="back" href={url('/shrimpedia/')}>← Shrimpedia</a>
    <time class="date" datetime={item.data.date.toISOString()}>{fmt(item.data.date)}</time>
    <h1 class="post-title">{item.data.title}</h1>
    <Image class="lab-hero" src={item.data.image} alt={item.data.imageAlt ?? item.data.title} widths={[560, 1120]} sizes="(max-width: 720px) 100vw, 720px" />
    <article class="prose"><Content /></article>
  </main>
</Base>
