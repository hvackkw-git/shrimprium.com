---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { withBase, GAME_URL } from '../config/site.js';
import { BREEDS, gradeOf, spriteUrl, overlayUrl } from '../data/wiki.js';

// 위키 미리보기: 별점 높은 순 8종
const featured = [...BREEDS].sort((a, b) => b.stars - a.stars).slice(0, 8);
const spriteStyle = (b) => {
  const layers = [];
  if (b.overlay) layers.push(`url('${withBase(overlayUrl(b.overlay))}')`);
  layers.push(`url('${withBase(spriteUrl(b.sprite))}')`);
  return `background-image:${layers.join(',')}`;
};
const starText = (n) => '★'.repeat(Math.floor(n)) + (n % 1 ? '½' : '');

const latestNews = (await getCollection('news')).sort((a, b) => b.data.date - a.data.date).slice(0, 2);
const fmt = (d) => d.toISOString().slice(0, 10);

// 채널 리스트형 메인 메뉴
const MENU = [
  { icon: '📖', name: '새우 위키', desc: '품종 32종 · 유전자 · 교배 레시피', href: '/wiki/', state: 'on', act: '문서 보기' },
  { icon: '🎮', name: '새우 팡팡', desc: '같은 색 새우 3매치 퍼즐', href: '/game/', state: 'on', act: 'PLAY' },
  { icon: '🎨', name: '디자인 스튜디오', desc: '새우·배경·블록 도트 에디터', href: '/studio/', state: 'on', act: '만들기' },
  { icon: '🐚', name: '수조 갤러리', desc: '수조 자랑 · 브리더 팔로우', href: '/gallery/', state: 'soon', act: '준비중' },
  { icon: '🌿', name: '사육 가이드', desc: '물잡이부터 번식까지', href: '/guide/', state: 'on', act: '읽기' },
  { icon: '💬', name: '커뮤니티', desc: '브리더들과 수다떠는 곳', href: '/community/', state: 'on', act: '입장하기' },
];

// 수조 채팅 목업 — 새우들이 떠드는 중
const CHAT = [
  { who: '체리새우', color: '#ff5fa8', msg: '밥 주세요 밥 밥' },
  { who: '야생새우', color: '#c8a675', msg: '오늘 물맛 좋다' },
  { who: '블루벨벳', color: '#57d4ff', msg: '수초 뒤가 명당임' },
  { who: '알비노', color: '#f0f0f8', msg: '나 방금 탈피함 ㅎㅎ' },
  { who: '오로라', color: '#b79cff', msg: '⭐ 각도 맞추는 중' },
  { who: '골든백', color: '#ffd166', msg: '등 라인 관리 꿀팁 공유함' },
];
---
<Base>
  <!-- ── HERO: 라이브 수조 캠 ──
       반응형 수조: 자갈 · 수초 · 마린 스노우 · 새우 2마리.
       폭이 넓어지면 새우는 크기 그대로 더 넓은 수조를 돌아다닌다. 게임 기능 없음. -->
  <section class="gametank" id="gametank" aria-label="새우가 헤엄치는 수조">
    <div class="gt-snow-back" aria-hidden="true"></div>
    <div class="gt-gravel" id="gtGravel" aria-hidden="true"></div>
    <div class="gt-plants" aria-hidden="true">
      <img src={withBase('/assets/seaweed/seaweed_s03.png')} alt="" draggable="false" />
      <img src={withBase('/assets/seaweed/seaweed_s08.png')} alt="" draggable="false" />
      <img src={withBase('/assets/seaweed/seaweed_s11.png')} alt="" draggable="false" />
    </div>
    <div class="gt-shrimp-layer" id="gtShrimp" aria-hidden="true">
      <div class="gt-shrimp" data-color="red"><i class="sprite"></i></div>
      <div class="gt-shrimp" data-color="blue"><i class="sprite"></i></div>
    </div>
    <div class="gt-snow-front" aria-hidden="true"></div>

    <!-- 게임 HUD 오버레이 -->
    <div class="gt-hud">
      <span class="hud-chip live">● LIVE</span>
      <span class="hud-chip">🌡 24.5°C</span>
      <span class="hud-chip">pH 7.2</span>
    </div>
    <div class="gt-caption">
      <p class="cap-eng">▸ NOW SWIMMING · TANK CAM</p>
      <p class="cap-title">오늘도 새우들은 평화롭습니다</p>
      <a class="px-btn primary cap-start" href={GAME_URL}>▶ GAME START</a>
    </div>
  </section>

  <!-- ── 프로필 카드 ── -->
  <section class="profile-card">
    <span class="pf-avatar"><i class="shrimp4" style={`--z:1.5;background-image:url('${withBase(spriteUrl('cherry_red'))}')`}></i></span>
    <div class="pf-info">
      <p class="pf-name">SHRIMPRIUM <span class="pf-check">✓</span></p>
      <p class="pf-bio">새우 키우기 · 교배 시뮬레이션 · 픽셀 수조</p>
      <div class="pf-tags">
        <span>#방치형</span><span>#유전교배</span><span>#도트새우</span>
      </div>
    </div>
    <a class="px-btn pink pf-play" href={GAME_URL}>▶ PLAY</a>
  </section>

  <!-- ── MAIN MENU: 채널 리스트 ── -->
  <div class="px-card theme-grape menu-card">
    <div class="px-head">
      <p class="px-title">MAIN MENU</p>
      <span class="px-meta">{MENU.length} CH</span>
    </div>
    <ul class="menu-list">
      {MENU.map((m) => (
        <li>
          <a class="menu-row" href={withBase(m.href)}>
            <span class="m-ico">{m.icon}</span>
            <span class="m-txt">
              <span class="m-name">{m.name}</span>
              <span class="m-desc">{m.desc}</span>
            </span>
            <span class="m-state">
              {m.state === 'on' && <span class="m-on">● ON</span>}
              {m.state === 'soon' && <span class="m-soon">● SOON</span>}
              <span class="m-act">{m.act}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- ── SHRIMP DEX 레일 ── -->
  <div class="rail-head">
    <h2>SHRIMP DEX</h2>
    <a class="more" href={withBase('/wiki/')}>전체 {BREEDS.length}종 →</a>
  </div>
  <div class="rail">
    {featured.map((b) => (
      <a class="rail-card" href={withBase('/wiki/')}>
        <span class="r-tank"><i class="shrimp4" style={`--z:1.4;${spriteStyle(b)}`}></i></span>
        <span class="r-name">{b.name}</span>
        <span class="r-stars">{starText(b.stars)} · {gradeOf(b.stars).label}</span>
      </a>
    ))}
  </div>

  <!-- ── EVENT 자리 ── -->
  <div class="event-box">
    <span class="ad">EVENT</span>
    <p class="ev-title">새우 콘테스트 준비 중</p>
    <p class="ev-desc">이 자리에 여러분의 수조가 걸립니다</p>
    <p class="ev-fine">갤러리 오픈과 함께 시작돼요 🤍</p>
  </div>

  <!-- ── TANK CHAT ── -->
  <div class="px-card theme-cyan chat-card">
    <div class="px-head">
      <p class="px-title">TANK CHAT</p>
      <span class="px-meta">수조 속 대화</span>
    </div>
    <div class="chat-body">
      {CHAT.map((c) => (
        <p class="chat-line"><b style={`color:${c.color}`}>{c.who}</b> {c.msg}</p>
      ))}
      <div class="chat-input" aria-hidden="true">
        <span>🗨 새우어(語) 번역기 개발 중…</span>
      </div>
    </div>
  </div>

  <!-- ── 최신 소식 ── -->
  <div class="rail-head">
    <h2>DEV LOG</h2>
    <a class="more" href={withBase('/news/')}>더 보기 →</a>
  </div>
  <ul class="card-list">
    {latestNews.map((post) => (
      <li>
        <a class="card" href={withBase(`/news/${post.id}/`)}>
          <p class="card-meta">{fmt(post.data.date)}</p>
          <p class="card-title">{post.data.title}</p>
        </a>
      </li>
    ))}
  </ul>

  <style>
    /* HUD 오버레이 — gametank의 pointer-events:none 규칙을 덮어씀 */
    .gt-hud {
      top: 12px; left: 12px; right: 12px;
      z-index: 300;
      display: flex;
      gap: 7px;
      pointer-events: none;
    }
    .hud-chip {
      font-family: var(--pixel9);
      font-size: 10px;
      letter-spacing: 0.06em;
      color: var(--text);
      background: rgba(8, 6, 16, 0.65);
      backdrop-filter: blur(4px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      padding: 5px 11px;
    }
    .hud-chip.live {
      color: #fff;
      background: linear-gradient(180deg, #ff6e7a, #e0304d);
      border-color: rgba(0, 0, 0, 0.4);
      box-shadow: 0 0 14px rgba(255, 90, 110, 0.55);
      animation: live-pulse 1.6s ease-in-out infinite;
    }
    .hud-chip:nth-child(2) { margin-left: auto; }
    .gt-caption {
      left: 0; right: 0; bottom: 0;
      z-index: 310;
      padding: 40px 18px 18px;
      background: linear-gradient(180deg, transparent, rgba(5, 8, 14, 0.82) 70%);
      pointer-events: none;
    }
    .cap-eng {
      font-family: var(--pixel9);
      font-size: 10px;
      letter-spacing: 0.22em;
      color: var(--warn);
      text-shadow: 0 0 10px rgba(255, 209, 102, 0.5);
      margin-bottom: 4px;
    }
    .cap-title {
      font-family: var(--pixel11);
      font-size: 19px;
      font-weight: 700;
      color: #fff;
      text-shadow: 0 0 14px rgba(255, 95, 168, 0.45), 0 2px 0 rgba(0, 0, 0, 0.6);
      margin-bottom: 12px;
    }
    .cap-start {
      pointer-events: auto;
      font-size: 14px;
      letter-spacing: 0.14em;
      padding: 12px 26px;
    }

    /* 프로필 카드 */
    .profile-card {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 14px;
      padding: 14px 16px;
      background: linear-gradient(180deg, rgba(32, 23, 54, 0.9), rgba(16, 11, 30, 0.9));
      border: 1px solid var(--line);
      border-radius: var(--r);
    }
    .pf-avatar {
      flex: 0 0 auto;
      width: 62px; height: 62px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      border-radius: 50%;
      background: linear-gradient(180deg, #0e3346, #071824);
      border: 2px solid var(--pink);
      box-shadow: 0 0 16px rgba(255, 95, 168, 0.45);
    }
    .pf-info { min-width: 0; }
    .pf-name {
      font-family: var(--pixel11);
      font-weight: 700;
      font-size: 15px;
      letter-spacing: 0.08em;
      margin: 0;
    }
    .pf-check {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 15px; height: 15px;
      font-size: 9px;
      color: #05240f;
      background: var(--info);
      border-radius: 50%;
      vertical-align: 1px;
    }
    .pf-bio { color: var(--pink); font-size: 12.5px; font-weight: 600; margin: 1px 0 6px; }
    .pf-tags { display: flex; gap: 6px; flex-wrap: wrap; }
    .pf-tags span {
      font-family: var(--pixel9);
      font-size: 10px;
      color: var(--muted);
      background: var(--panel-deep);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 3px 9px;
    }
    .pf-play { margin-left: auto; flex: 0 0 auto; font-size: 12px; padding: 10px 16px; }
    @media (max-width: 480px) {
      .pf-play { display: none; }
    }

    .menu-card { margin-top: 14px; }

    /* EVENT 박스 — 점선 광고 자리 패러디 */
    .event-box {
      position: relative;
      margin-top: 26px;
      padding: 22px 18px;
      text-align: center;
      border: 2px dashed rgba(228, 220, 250, 0.28);
      border-radius: var(--r);
      color: var(--muted);
    }
    .event-box .ad {
      position: absolute;
      top: 10px; right: 14px;
      font-family: var(--pixel9);
      font-size: 9px;
      letter-spacing: 0.2em;
      color: rgba(228, 220, 250, 0.4);
    }
    .ev-title { color: var(--text); font-weight: 700; font-size: 15px; margin-bottom: 2px; }
    .ev-desc { font-size: 13px; margin-bottom: 2px; }
    .ev-fine { font-family: var(--pixel9); font-size: 11px; margin: 0; opacity: 0.8; }

    /* TANK CHAT */
    .chat-card { margin-top: 26px; }
    .chat-body { padding: 2px 16px 16px; }
    .chat-line { font-size: 13.5px; margin-bottom: 9px; }
    .chat-line b { font-weight: 700; margin-right: 6px; }
    .chat-input {
      margin-top: 14px;
      padding: 11px 14px;
      font-size: 12.5px;
      color: var(--muted);
      background: var(--panel-deep);
      border: 1px solid var(--line);
      border-radius: 999px;
    }
  </style>

  <script>
    const tank = document.getElementById('gametank');
    const gravelLayer = document.getElementById('gtGravel');

    // ── 자갈: 게임 본체(mountAquarium)의 캔버스 베이크를 이식. 현재 폭에 맞춰 생성 ──
    const makeRng = (seed) => { let s = seed >>> 0; return () => { s = (Math.imul(s, 1664525) + 1013904223) | 0; return (s >>> 0) / 0x100000000; }; };
    const shades = [
      ['#384d65', '#1f2b38', '#17202a', '#10161c'],
      ['#415c77', '#243342', '#1b2632', '#121a21'],
      ['#202f3b', '#121a21', '#0e1419', '#090d11'],
      ['#58687c', '#313a45', '#252c34', '#191d23'],
    ];
    const buildGravel = (W) => {
      const old = gravelLayer.querySelector('.gravel-sprite');
      if (old) old.remove();
      const H = 50;
      const cv = document.createElement('canvas');
      cv.className = 'gravel-sprite';
      cv.width = W; cv.height = H;
      const c = cv.getContext('2d');
      const rng = makeRng(0x6B5A47); // 시드 고정 — 같은 폭이면 같은 자갈밭
      const pebble = (cx, cy, rx, ry, alpha) => {
        const [hi, base, mid, sh] = shades[Math.floor(rng() * shades.length)];
        c.globalAlpha = alpha;
        const X = Math.round(cx), Y = Math.round(cy);
        for (let dy = -ry; dy <= ry; dy++) {
          const t = dy / (ry + 0.5);
          const hw = Math.round(rx * Math.sqrt(1 - t * t));
          const y = Y + dy;
          const ringHw = (s, o) => { const tt = (dy + ry * o) / (ry * s + 0.5); return tt >= -1 && tt <= 1 ? Math.min(hw, Math.round(rx * s * Math.sqrt(1 - tt * tt))) : -1; };
          let w1 = ringHw(0.88, 0.22); const w2 = ringHw(0.7, 0.4);
          if (w1 < w2) w1 = w2;
          if (w2 >= 0) { c.fillStyle = base; c.fillRect(X - w2, y, w2 * 2 + 1, 1); }
          if (w1 >= 0) {
            if (w1 > w2) {
              c.fillStyle = mid;
              if (w2 >= 0) { c.fillRect(X - w1, y, w1 - w2, 1); c.fillRect(X + w2 + 1, y, w1 - w2, 1); }
              else { c.fillRect(X - w1, y, w1 * 2 + 1, 1); }
            }
            if (hw > w1) { c.fillStyle = sh; c.fillRect(X - hw, y, hw - w1, 1); c.fillRect(X + w1 + 1, y, hw - w1, 1); }
          } else { c.fillStyle = sh; c.fillRect(X - hw, y, hw * 2 + 1, 1); }
          const th = (dy + ry * 0.45) / (ry * 0.38 + 0.5);
          if (th >= -1 && th <= 1) {
            const hhw = Math.round(rx * 0.42 * Math.sqrt(1 - th * th));
            const hx = X - Math.round(rx * 0.15);
            const x0 = Math.max(X - hw, hx - hhw), x1 = Math.min(X + hw, hx + hhw);
            c.fillStyle = hi; c.fillRect(x0, y, x1 - x0 + 1, 1);
          }
        }
      };
      const count = Math.round(W * 0.875); // 게임과 같은 밀도(320px당 280알갱이)
      for (let i = 0; i < count; i++) {
        const size = 5 + rng() * 11;
        const rx = Math.max(2, Math.round(size / 2));
        const ry = Math.max(2, Math.round((size * 0.85) / 2));
        const h = ry * 2 + 1;
        const bottom = rng() * Math.max(0, H - h);
        pebble(rng() * W, H - bottom - ry - 0.5, rx, ry, 0.55 + rng() * 0.4);
      }
      c.globalAlpha = 1;
      gravelLayer.appendChild(cv);
    };
    if (!gravelLayer.querySelector('.gravel-underlay')) {
      const u = document.createElement('div');
      u.className = 'gravel-underlay';
      gravelLayer.appendChild(u);
    }

    // ── 새우 2마리: 크기 고정. 수조가 넓어지면 더 넓게 돌아다닌다 ──
    const shrimps = [...document.querySelectorAll('.gt-shrimp')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SIZE = 32, GRAVEL = 50, SURFACE = 16;
    const rand = (a, b) => a + Math.random() * (b - a);

    const fish = shrimps.map((el, i) => ({
      el,
      sprite: el.querySelector('.sprite'),
      x: rand(40, 160),
      y: rand(60, 160),
      vx: rand(-0.4, 0.4) || 0.3,
      vy: rand(-0.2, 0.2),
      turnAt: 0,
      jumpAt: rand(1500, 4000) * (i + 1),
      face: 1,
    }));

    const draw = (f) => {
      f.el.style.transform = `translate(${f.x}px, ${f.y}px)`;
      f.sprite.style.transform = `scale(${1.5 * f.face}, 1.5)`; // 왼쪽 바라봄 → 오른쪽 갈 때 반전
    };

    // 자갈 재생성(폭 변화 시) + 새우 경계 적용
    let lastW = 0;
    const onResize = () => {
      const W = Math.round(gravelLayer.clientWidth);
      if (W && Math.abs(W - lastW) > 8) { lastW = W; buildGravel(W); }
    };
    onResize();
    new ResizeObserver(onResize).observe(tank);

    if (reduce) {
      fish.forEach(draw);
    } else {
      let last = performance.now();
      const tick = (now) => {
        const dt = Math.min(now - last, 50); last = now;
        const xMax = tank.clientWidth - SIZE;
        const yMin = SURFACE, yMax = tank.clientHeight - GRAVEL - SIZE;
        for (const f of fish) {
          if (now > f.turnAt) { f.vx += rand(-0.25, 0.25); f.vy += rand(-0.15, 0.15); f.turnAt = now + rand(700, 2200); }
          if (now > f.jumpAt) { f.vx += rand(-1.6, 1.6); f.vy -= rand(1.4, 2.6); f.jumpAt = now + rand(2500, 6000); }
          f.vy += 0.012; f.vx *= 0.985; f.vy *= 0.99;
          f.vx = Math.max(-2.4, Math.min(2.4, f.vx));
          f.vy = Math.max(-3, Math.min(2.4, f.vy));
          f.x += f.vx * dt * 0.06; f.y += f.vy * dt * 0.06;
          if (f.x < 0) { f.x = 0; f.vx = Math.abs(f.vx); }
          if (f.x > xMax) { f.x = xMax; f.vx = -Math.abs(f.vx); }
          if (f.y < yMin) { f.y = yMin; f.vy = Math.abs(f.vy) * 0.6; }
          if (f.y > yMax) { f.y = yMax; f.vy = -Math.abs(f.vy); }
          if (Math.abs(f.vx) > 0.05) f.face = f.vx > 0 ? -1 : 1;
          draw(f);
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  </script>
</Base>
