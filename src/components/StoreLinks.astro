---
import { GAME_URL, APP_STORE_URL, PLAY_STORE_URL } from '../site.js';
---
<div class="cta">
  <a class="play" href={GAME_URL}>Play now</a>
  {APP_STORE_URL && (
    <a class="store" href={APP_STORE_URL} rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.1-1.2 2.9-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.4-.9-2.4-3.9zM14 5.5c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1 .1 2.1-.6 2.8-1.4z"/></svg>
      <span><small>Download on the</small>App Store</span>
    </a>
  )}
  {PLAY_STORE_URL && (
    <a class="store" href={PLAY_STORE_URL} rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 2.8c-.3.3-.4.7-.4 1.2v16c0 .5.1.9.4 1.2l9-9.2-9-9.2zm10.1 10.3 2.5 2.5-11 6.3c-.4.2-.8.3-1.1.2l9.6-9zm0-2.2-9.6-9c.3-.1.7 0 1.1.2l11 6.3-2.5 2.5zm3.6-1.5 2.9 1.7c.8.5.8 1.3 0 1.8l-2.9 1.7-2.7-2.6 2.7-2.6z"/></svg>
      <span><small>Get it on</small>Google Play</span>
    </a>
  )}
</div>
