---
import { NAV, SUPPORT_EMAIL, withBase } from '../config/site.js';
import '../styles/global.css';

const { title, description = '생태계가 진짜로 돌아가는 픽셀 새우 수조 시뮬레이션, Shrimprium' } = Astro.props;
const pageTitle = title ? `${title} — Shrimprium` : 'Shrimprium — 픽셀 새우 수조 시뮬레이션';
const currentPath = Astro.url.pathname;
// 홈(/)은 접두사 매칭이 항상 참이라 정확 일치로 판정.
const isCurrent = (href) =>
  href === '/' ? currentPath === withBase('/') : currentPath.startsWith(withBase(href));
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#07111c" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={new URL(currentPath, Astro.site)} />
  <meta property="og:image" content={new URL(withBase('/assets/og-image.png'), Astro.site)} />
  <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href={withBase('/')}>SHRIMPRIUM</a>
      <nav aria-label="주요 메뉴">
        {NAV.map((item) => (
          <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>문의 <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> · <a href={withBase('/privacy.html')}>개인정보처리방침</a></p>
      <p class="fine">© {new Date().getFullYear()} Shrimprium · Galmuri font © Minseo Lee, SIL OFL 1.1</p>
    </div>
  </footer>
</body>
</html>
