---
import { CONTACT_EMAIL, url } from '../site.js';
import '../styles/global.css';

const { title, description = 'A pixel-art shrimp tank and aquarium game where the ecosystem actually runs. Raise and breed shrimp, decorate your tank, and watch plants, microbes, and water chemistry turn a glass box into a living world.', cosmos = 'ambient', article, keywords, structuredData = [], image, imageAlt, noindex = false, footer = true } = Astro.props;
const pageTitle = title ? `${title} · Shrimprium` : 'Shrimprium — Grow a Tiny World in a Pixel Shrimp Aquarium';
const canonical = new URL(Astro.url.pathname, Astro.site);
// 글마다 대표 그림이 있으면 링크 미리보기·검색 결과에 그 그림을 씀.
const ogImage = new URL(image ?? url('/og.png'), Astro.site);
const navItems = [
  { label: 'Devlog', path: '/devlog/' },
  { label: 'Lab', path: '/lab/' },
  { label: 'Shrimpedia', short: 'Wiki', path: '/shrimpedia/' },
  { label: 'About Me', short: 'About', path: '/about/' },
];
const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
const currentSection = (path) => currentPath === url(path) ? 'page' : currentPath.startsWith(url(path)) ? 'location' : undefined;
// 데브로그 글이면 article 정보를 구글에 BlogPosting으로 알려줌.
const jsonLd = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: article.date.toISOString(),
  ...(article.author && { author: { '@type': 'Person', name: article.author } }),
  image: ogImage.href,
  mainEntityOfPage: canonical.href,
  publisher: { '@type': 'Organization', name: 'Shrimprium' },
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#04060b" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title="Shrimprium Devlog" href={new URL(url('/devlog/rss.xml'), Astro.site)} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="Shrimprium" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={ogImage} />
  {!image && <meta property="og:image:width" content="1200" />}
  {!image && <meta property="og:image:height" content="630" />}
  <meta property="og:image:alt" content={imageAlt ?? 'Shrimprium, a pixel-art shrimp aquarium sim'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {article && <meta property="article:published_time" content={article.date.toISOString()} />}
  {article?.author && <meta property="article:author" content={article.author} />}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" />
</head>
<body>
  <canvas class="cosmos" data-mode={cosmos} aria-hidden="true"></canvas>

  <header class="top">
    <a class="brand" href={url('/')}>Shrimprium</a>
    <nav class="nav" aria-label="Main navigation">
      {navItems.map(({ label, short, path }) => (
        <a class="devlog-btn" href={url(path)} aria-current={currentSection(path)}>{short ? <><span class="nav-full">{label}</span><span class="nav-short">{short}</span></> : label}</a>
      ))}
    </nav>
  </header>

  <slot />

  {footer && <footer class="foot">
    <span>© {new Date().getFullYear()} Shrimprium</span>
    <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    <a href={url('/privacy.html')}>Privacy Policy</a>
  </footer>}

  <script>
    import { startCosmos } from '../scripts/cosmos.js';
    startCosmos(document.querySelector('canvas.cosmos'));
  </script>
</body>
</html>
